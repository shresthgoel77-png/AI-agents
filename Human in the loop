from langgraph.graph import StateGraph,START,END
from langgraph.checkpoint.memory import MemorySaver
from typing import TypedDict
class Agentstate(TypedDict):
    goal:str
    plan:str
def generate_plan(state: AgentState):
    print(f"\n🤖 Agent is thinking about goal: '{state['goal']}'...")
    return {"plan": "print('Hello from LangGraph Agent!')"}

def execute_action(state: AgentState):
    print(f"\n🚀 [Execution Node] Running code: {state['plan']}")
    return state
workflow = StateGraph(Agentstate)
workflow.add_node("generate_plan",generate_plan)
workflow.add_node("execute_action",execute_action)
workflow.add_edge(START,"generate_plan")
workflow.add_edge("generate_plan","execute_action")
workflow.add_edge("execute_action",END)
memory = MemorySaver()
app = workflow.compile(checkpointer = memory,interrupt_before=["execute_action"])
config = {"configurable": {"thread_id": "1"}}
inputs = {"goal": "Create a greeting script"}
print("--- Step 1: Agent starts working ---")
for event in app.stream(inputs, config):
    pass
current_state = app.get_state(config)
proposed_plan = current_state.values.get("plan")

print(f"\n💡 Agent's Proposed Plan: {proposed_plan}")
choice = input("👤 Do you want to approve this execution? (y/n): ").strip().lower()

if choice == 'y':
    print("\n✅ Approved! Resuming graph execution...")
    # Passing None to app.stream resumes the graph from where it paused
    for event in app.stream(None, config):
        pass
else:
    print("\n❌ Rejected! Agent workflow halted safely.")